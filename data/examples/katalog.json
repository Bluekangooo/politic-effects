{
  "version": "0.1.0",
  "zielgruppen": [
    {
      "id": "soli-pflichtig-arbeitnehmer",
      "name": "Soli-pflichtige Arbeitnehmer",
      "beschreibung": "Angestellte mit Bruttoeinkommen über der Soli-Freigrenze (~73.000 €)"
    },
    {
      "id": "soli-pflichtig-selbststaendig",
      "name": "Soli-pflichtige Selbstständige",
      "beschreibung": "Selbstständige mit Einkommen über der Soli-Freigrenze"
    },
    {
      "id": "kapitalanleger-soli",
      "name": "Kapitalanleger mit Soli",
      "beschreibung": "Personen mit Kapitalerträgen, auf die der Solidaritätszuschlag erhoben wird"
    },
    {
      "id": "nicht-betroffen",
      "name": "Nicht Soli-pflichtig",
      "beschreibung": "Keine direkte Entlastung durch die Abschaffung"
    }
  ],
  "fragen": [
    {
      "id": "basis-alter",
      "text": "Wie alt sind Sie?",
      "typ": "number",
      "einheit": "Jahre",
      "hinweis": "Ganzzahl in Jahren"
    },
    {
      "id": "basis-erwachsene-steuerlich",
      "text": "Wie viele steuerlich relevante Erwachsene leben in Ihrem Haushalt?",
      "typ": "number",
      "einheit": "Personen",
      "hinweis": "1 = allein, 2 = zusammen veranlagt mit Partner/in"
    },
    {
      "id": "basis-einkommen-angestellt",
      "text": "Jährliches Bruttoeinkommen aus Anstellung oder Beamtenverhältnis",
      "typ": "number",
      "einheit": "EUR/Jahr",
      "hinweis": "0 eingeben, wenn nicht zutreffend"
    },
    {
      "id": "basis-einkommen-selbststaendig",
      "text": "Jährliches Bruttoeinkommen aus Selbstständigkeit",
      "typ": "number",
      "einheit": "EUR/Jahr",
      "hinweis": "0 eingeben, wenn nicht zutreffend"
    },
    {
      "id": "basis-partner-einkommen",
      "text": "Jährliches Bruttoeinkommen Ihres Partners / Ihrer Partnerin",
      "typ": "number",
      "einheit": "EUR/Jahr",
      "hinweis": "0 eingeben, wenn allein steuerlich oder nicht zutreffend"
    },
    {
      "id": "basis-kinder-anzahl",
      "text": "Wie viele Kinder haben Sie?",
      "typ": "number",
      "einheit": "Anzahl",
      "hinweis": "0 eingeben, wenn keine Kinder"
    },
    {
      "id": "basis-kapitalertraege",
      "text": "Jährliche Kapitalerträge (z. B. Zinsen, Dividenden)",
      "typ": "number",
      "einheit": "EUR/Jahr",
      "hinweis": "0 eingeben, wenn keine"
    },
    {
      "id": "basis-kirchensteuer",
      "text": "Sind Sie kirchensteuerpflichtig?",
      "typ": "number",
      "einheit": "0/1",
      "hinweis": "0 = nein, 1 = ja"
    },
    {
      "id": "basis-steuerlast-gesamt",
      "text": "Ihre jährliche Gesamtsteuerlast (ESt, Soli, AbgSt, KiSt)",
      "typ": "number",
      "einheit": "EUR/Jahr",
      "hinweis": "0 eingeben, um automatisch zu schätzen"
    }
  ],
  "vorhaben": [
    {
      "id": "soli-abschaffung",
      "titel": "Abschaffung des Solidaritätszuschlags",
      "beschreibung": "Vollständiger Wegfall des Solidaritätszuschlags (5,5 % auf die Einkommensteuer bzw. Abgeltungsteuer) für alle verbleibenden Zahler.",
      "metadata": {
        "quelle": "Modellhafte Abschätzung basierend auf Steuerrecht 2024/25",
        "status": "modelliert",
        "erstelltAm": "2026-08-15"
      },
      "staatsfinanzierung": {
        "fiskalausfall_feld": "gesamt_fiskalausfall_mrd",
        "richtung": "belastung"
      },
      "untervorhaben": [
        {
          "id": "soli-arbeit-abschaffung",
          "titel": "Wegfall für Arbeitseinkommen",
          "beschreibung": "Abschaffung des Soli auf Lohn- und Gehaltseinkommen für die verbleibenden Soli-pflichtigen (ca. oberes Einkommensdrittel).",
          "zielgruppen": [
            {
              "zielgruppeId": "soli-pflichtig-arbeitnehmer",
              "fragenIds": ["basis-einkommen-angestellt"],
              "rechenvorschrift": {
                "variablen": {
                  "einkommen_angestellt": {
                    "beschreibung": "Jährliches Bruttoeinkommen aus Anstellung in EUR",
                    "quelle": "nutzerprofil"
                  },
                  "soli_freigrenze": {
                    "beschreibung": "Freigrenze ab der Soli fällig wird (Einzelveranlagung)",
                    "quelle": "konstante",
                    "standardwert": 73000
                  },
                  "soli_satz": {
                    "beschreibung": "Solidaritätszuschlag-Satz auf die Einkommensteuer",
                    "quelle": "konstante",
                    "standardwert": 0.055
                  }
                },
                "formeln": {
                  "kurz": "einkommen_angestellt > soli_freigrenze ? Math.min((einkommen_angestellt - soli_freigrenze) * 0.026, 4000) : 0",
                  "mittel": "einkommen_angestellt > soli_freigrenze ? Math.min((einkommen_angestellt - soli_freigrenze) * 0.028, 4500) : 0",
                  "lang": "einkommen_angestellt > soli_freigrenze ? Math.min((einkommen_angestellt - soli_freigrenze) * 0.03, 5000) : 0"
                },
                "einheit": "EUR/Jahr",
                "erlaeuterung": "Geschätzte jährliche Entlastung durch Wegfall des Soli auf Arbeitseinkommen (vereinfachtes Modell)"
              }
            },
            {
              "zielgruppeId": "soli-pflichtig-selbststaendig",
              "fragenIds": ["basis-einkommen-selbststaendig"],
              "rechenvorschrift": {
                "variablen": {
                  "einkommen_selbststaendig": {
                    "beschreibung": "Jährliches Bruttoeinkommen aus Selbstständigkeit in EUR",
                    "quelle": "nutzerprofil"
                  },
                  "soli_freigrenze": {
                    "beschreibung": "Freigrenze ab der Soli fällig wird",
                    "quelle": "konstante",
                    "standardwert": 73000
                  }
                },
                "formeln": {
                  "kurz": "einkommen_selbststaendig > soli_freigrenze ? Math.min((einkommen_selbststaendig - soli_freigrenze) * 0.03, 5500) : 0",
                  "mittel": "einkommen_selbststaendig > soli_freigrenze ? Math.min((einkommen_selbststaendig - soli_freigrenze) * 0.032, 6000) : 0",
                  "lang": "einkommen_selbststaendig > soli_freigrenze ? Math.min((einkommen_selbststaendig - soli_freigrenze) * 0.035, 6500) : 0"
                },
                "einheit": "EUR/Jahr",
                "erlaeuterung": "Entlastung für Selbstständige (etwas höher wegen Gewerbesteuer-Effekten im Modell)"
              }
            }
          ]
        },
        {
          "id": "soli-kapital-abschaffung",
          "titel": "Wegfall auf Kapitalerträge",
          "beschreibung": "Abschaffung des Soli-Anteils auf Kapitalerträge (Abgeltungsteuer).",
          "zielgruppen": [
            {
              "zielgruppeId": "kapitalanleger-soli",
              "fragenIds": ["basis-kapitalertraege"],
              "rechenvorschrift": {
                "variablen": {
                  "kapitalertraege": {
                    "beschreibung": "Jährliche Kapitalerträge in EUR",
                    "quelle": "nutzerprofil"
                  },
                  "abgeltungsteuer_satz": {
                    "beschreibung": "Abgeltungsteuer-Satz",
                    "quelle": "konstante",
                    "standardwert": 0.25
                  },
                  "soli_satz": {
                    "beschreibung": "Soli-Satz auf Abgeltungsteuer",
                    "quelle": "konstante",
                    "standardwert": 0.055
                  }
                },
                "formeln": {
                  "kurz": "kapitalertraege > 1000 ? kapitalertraege * abgeltungsteuer_satz * soli_satz : 0",
                  "mittel": "kapitalertraege > 1000 ? kapitalertraege * abgeltungsteuer_satz * soli_satz : 0",
                  "lang": "kapitalertraege > 1000 ? kapitalertraege * abgeltungsteuer_satz * soli_satz : 0"
                },
                "einheit": "EUR/Jahr",
                "erlaeuterung": "Entlastung = entfallender Soli-Anteil auf Abgeltungsteuer"
              }
            }
          ]
        }
      ],
      "zielgruppen": [
        {
          "zielgruppeId": "nicht-betroffen",
          "fragenIds": [
            "basis-einkommen-angestellt",
            "basis-einkommen-selbststaendig",
            "basis-kapitalertraege"
          ],
          "rechenvorschrift": {
            "variablen": {},
            "formeln": {
              "kurz": "0",
              "mittel": "0",
              "lang": "0"
            },
            "einheit": "EUR/Jahr",
            "erlaeuterung": "Keine Entlastung für nicht Soli-pflichtige Personen"
          }
        }
      ]
    }
  ],
  "gesellschaft": {
    "anzahl_soli_pflichtige": 4500000,
    "durchschnitt_entlastung_arbeit": 2400,
    "anzahl_kapitalanleger_soli": 2800000,
    "durchschnitt_entlastung_kapital": 180,
    "gesamt_fiskalausfall_mrd": 11.2,
    "steueraufkommen_gesamt_mrd": 900
  }
}
