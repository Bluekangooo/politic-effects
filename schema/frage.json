{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://politic-effects.dev/schema/frage.json",
  "title": "Frage",
  "type": "object",
  "required": ["id", "text", "typ", "einheit"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "typ": {
      "type": "string",
      "enum": ["number"]
    },
    "einheit": { "type": "string", "minLength": 1 },
    "hinweis": { "type": "string" },
    "dynamisch": { "type": "boolean" },
    "kontextIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
