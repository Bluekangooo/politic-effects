{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://politic-effects.dev/schema/variablen-definition.json",
  "title": "VariablenDefinition",
  "type": "object",
  "required": ["beschreibung", "quelle"],
  "additionalProperties": false,
  "properties": {
    "beschreibung": { "type": "string", "minLength": 1 },
    "quelle": {
      "type": "string",
      "enum": ["nutzerprofil", "gesellschaft", "konstante"]
    },
    "standardwert": { "type": "number" }
  }
}
