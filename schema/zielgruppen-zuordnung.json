{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://politic-effects.dev/schema/zielgruppen-zuordnung.json",
  "title": "ZielgruppenZuordnung",
  "type": "object",
  "required": ["zielgruppeId", "fragenIds", "rechenvorschrift"],
  "additionalProperties": false,
  "properties": {
    "zielgruppeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "fragenIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "rechenvorschrift": { "$ref": "rechenvorschrift.json" }
  }
}
