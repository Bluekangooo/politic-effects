{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@engine/*": ["../src/engine/*"],
      "@domain/*": ["../src/types/*"],
      "@data/*": ["../data/*"]
    }
  },
  "include": ["src", "../src/engine", "../src/types", "../data"]
}
